# ─── Database (Turso) ─────────────────────────────────────────────────────────
DATABASE_URL=libsql://your-db.turso.io
DATABASE_AUTH_TOKEN=your-turso-token

# ─── Auth ─────────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=change-me-32-chars-minimum

# ─── URLs (set to your real domain in production) ─────────────────────────────
WEBSITE_URL=https://frame.tuodominio.it/
APP_URL=https://frame.tuodominio.it

# ─── Google OAuth (opzionale) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Storage (Cloudflare R2) ──────────────────────────────────────────────────
S3_ENDPOINT=https://xxxxx.r2.cloudflarestorage.com
S3_BUCKET=frame
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://cdn.tuodominio.it

# ─── Email (Gmail App Password) ───────────────────────────────────────────────
GMAIL_USER=tua@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ─── Billing (Autumn) ─────────────────────────────────────────────────────────
AUTUMN_SECRET_KEY=

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production
